<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Large (sy11a_analyzers case 0002, R-025): tests run real git through ProcessRunner. -->
    <Sy11aTestTier>large</Sy11aTestTier>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kbo\Kbo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\schemas\golden\**\*.ndjson" LinkBase="fixtures\golden" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixtures\broken\**\*.ndjson" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>