{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kb-observability/schemas/context.loaded/1",
  "title": "context.loaded v1 — implicit context (CLAUDE.md/AGENTS.md/memory) loaded at session start",
  "$ref": "https://kb-observability/schemas/envelope/1",
  "type": "object",
  "properties": {
    "type": { "const": "context.loaded" },
    "schemaref": { "const": "context.loaded/1" },
    "data": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "contenthash": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{16}$" }
          ],
          "description": "SHA-256 truncated to 16 hex chars; only when kbroot != null and file <= 5 MB (G2-5)"
        },
        "size": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "File size in bytes, recorded when the file exceeds the 5 MB hash cap"
        },
        "raw": {
          "type": "object",
          "description": "Agent-native payload, untouched (P3)"
        }
      },
      "required": ["path", "contenthash", "raw"]
    }
  }
}
