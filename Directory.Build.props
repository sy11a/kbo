<Project>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Sy11a.Analyzers policy (BL-503): version pinned exactly in Directory.Packages.props; restored from the "github" source in nuget.config. -->
    <PackageReference Include="Sy11a.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
