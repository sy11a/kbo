<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exact: sy11a-test reads coverage from this version (SYT0009). -->
    <PackageVersion Include="coverlet.MTP" Version="[10.1.0]" />
    <PackageVersion Include="DuckDB.NET.Data.Full" Version="1.5.5" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- The Sy11a.Analyzers pin is exact (BL-503); the sy11a.lint version in .config/dotnet-tools.json moves with it in lockstep. -->
    <PackageVersion Include="Sy11a.Analyzers" Version="[0.12.0]" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

</Project>
