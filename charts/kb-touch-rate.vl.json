{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Share of sessions touching registered knowledge, daily",
  "usermeta": {
    "kbo": {
      "ru": "Что показывает: долю сессий агентов, в которых была прочитана хотя бы одна заметка из зарегистрированной базы знаний. Тонкая линия с точками — по дням, толстая — среднее за 7 дней. Куда смотреть: зелёная зона (выше 50%) — база знаний реально участвует в работе; красная зона (ниже 20%) — агенты решают задачи, не заглядывая в базу. Колесо мыши — масштаб по времени, наведите на точку — детали дня."
    }
  },
  "width": "container",
  "height": 220,
  "data": { "values": [] },
  "layer": [
    {
      "data": { "values": [ {} ] },
      "mark": { "type": "rect", "color": "#c22e2d", "opacity": 0.07 },
      "encoding": { "y": { "datum": 0 }, "y2": { "datum": 0.2 } }
    },
    {
      "data": { "values": [ {} ] },
      "mark": { "type": "rect", "color": "#1baf7a", "opacity": 0.08 },
      "encoding": { "y": { "datum": 0.5 }, "y2": { "datum": 1 } }
    },
    {
      "params": [ { "name": "zoomTouch", "select": { "type": "interval", "bind": "scales", "encodings": ["x"] } } ],
      "mark": { "type": "line", "strokeWidth": 1.5, "opacity": 0.45, "point": { "size": 35 } },
      "encoding": {
        "x": { "field": "date", "type": "temporal", "title": null },
        "y": { "field": "rate", "type": "quantitative", "title": "KB-touch rate", "axis": { "format": ".0%" }, "scale": { "domain": [0, 1] } },
        "color": { "value": "#2a78d6" },
        "tooltip": [
          { "field": "date", "type": "temporal" },
          { "field": "rate", "type": "quantitative", "format": ".0%" },
          { "field": "touched", "type": "quantitative", "title": "sessions touching KB" },
          { "field": "sessions", "type": "quantitative" }
        ]
      }
    },
    {
      "transform": [
        { "window": [ { "op": "mean", "field": "rate", "as": "rate7d" } ], "sort": [ { "field": "date" } ], "frame": [-6, 0] }
      ],
      "mark": { "type": "line", "strokeWidth": 3 },
      "encoding": {
        "x": { "field": "date", "type": "temporal" },
        "y": { "field": "rate7d", "type": "quantitative" },
        "color": { "value": "#2a78d6" },
        "tooltip": [
          { "field": "date", "type": "temporal" },
          { "field": "rate7d", "type": "quantitative", "format": ".0%", "title": "7-day average" }
        ]
      }
    }
  ]
}
