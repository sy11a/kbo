{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Zero-hit share of knowledge searches, daily",
  "usermeta": {
    "kbo": {
      "ru": "Что показывает: долю поисков по базе знаний, которые ничего не нашли (0 совпадений). Тонкая линия с точками — по дням, толстая — среднее за 7 дней. Куда смотреть: зелёная зона (ниже 10%) — искомое обычно находится; красная зона (выше 30%) — агенты ищут знания, которых нет или которые плохо названы; каждая такая точка — кандидат на новую заметку или переименование."
    }
  },
  "width": "container",
  "height": 220,
  "data": { "values": [] },
  "layer": [
    {
      "data": { "values": [ {} ] },
      "mark": { "type": "rect", "color": "#1baf7a", "opacity": 0.08 },
      "encoding": { "y": { "datum": 0 }, "y2": { "datum": 0.1 } }
    },
    {
      "data": { "values": [ {} ] },
      "mark": { "type": "rect", "color": "#c22e2d", "opacity": 0.07 },
      "encoding": { "y": { "datum": 0.3 }, "y2": { "datum": 1 } }
    },
    {
      "params": [ { "name": "zoomSearch", "select": { "type": "interval", "bind": "scales", "encodings": ["x"] } } ],
      "mark": { "type": "line", "strokeWidth": 1.5, "opacity": 0.45, "point": { "size": 35 } },
      "encoding": {
        "x": { "field": "date", "type": "temporal", "title": null },
        "y": { "field": "rate", "type": "quantitative", "title": "failed-search rate", "axis": { "format": ".0%" }, "scale": { "domain": [0, 1] } },
        "color": { "value": "#eb6834" },
        "tooltip": [
          { "field": "date", "type": "temporal" },
          { "field": "rate", "type": "quantitative", "format": ".0%" },
          { "field": "zeroHits", "type": "quantitative" },
          { "field": "searches", "type": "quantitative" }
        ]
      }
    },
    {
      "transform": [
        { "window": [ { "op": "mean", "field": "rate", "as": "rate7d" } ], "sort": [ { "field": "date" } ], "frame": [-6, 0] }
      ],
      "mark": { "type": "line", "strokeWidth": 3 },
      "encoding": {
        "x": { "field": "date", "type": "temporal" },
        "y": { "field": "rate7d", "type": "quantitative" },
        "color": { "value": "#eb6834" },
        "tooltip": [
          { "field": "date", "type": "temporal" },
          { "field": "rate7d", "type": "quantitative", "format": ".0%", "title": "7-day average" }
        ]
      }
    }
  ]
}
