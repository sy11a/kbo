<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>kbo</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kbo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\**\*.json" Exclude="..\..\schemas\golden\**" LogicalName="schemas/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\charts\*.vl.json" LogicalName="charts/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
